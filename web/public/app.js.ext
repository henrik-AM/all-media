function openKanalErstellen() {
  openErstellenSeite('community');
}

/**
 * „Community erstellen“ und „Unterthema erstellen“ nach dem Figma-Prototyp
 * (Kästen 28/10.2 und 16, Feedback 28.09.2026).
 *
 * Henrik: „…halte dich, wenn ich auf Neues Unterthema erstellen drücke,
 * explizit an meinen Figma Prototypen." Aufbau wie die Frames
 * „CC + Unterthema erstellen“ (928:13446) und „CP + Kanal erstellen“
 * (942:15097): X, „✳ Pflichtfeld“, großes Namensfeld, (Bild), Biografie,
 * Link, (Unterthemen) bzw. „Privates Unterthema“, „Einladungslink senden“,
 * QR-Code, unten „fertig“.
 *
 * Liegt im Overlay, also vor jeder Seite (Kasten 10.1). Felder, Grenzen,
 * Texte und Einladungslink aus gemeinsam/erstellen.js — dieselben wie in der
 * App (app/screens/communities/ErstellenScreen.tsx). Der Einladungscode
 * entsteht hier, damit Link und QR-Code schon dastehen; gültig wird er mit
 * „fertig“ (Schema 99).
 */
function openErstellenSeite(art, community) {
  const T = Erstellen.TEXTE;
  const istCommunity = art === 'community';
  const code = Erstellen.neuerCode(crypto.getRandomValues(new Uint8Array(Erstellen.CODE_LAENGE)));
  const einladung = Erstellen.link(code, location.origin);
  const stand = { bild: null, unterthemen: [], laeuft: false };

  overlay.hidden = false;
  overlay.innerHTML = `
    <div class="erstellseite" data-erstellseite="${art}">
      <div class="erstellseite__kopf">
        <button class="erstellseite__zu" id="esZu" aria-label="${esc(T.schliessen)}">${ICONS.close}</button>
      </div>
      <div class="erstellseite__inhalt scroll">
        <p class="erstellseite__pflicht"><span class="erstellseite__stern">✳</span> ${esc(T.pflichtfeld)}</p>
        <label class="erstellseite__name">
          <input id="esName" maxlength="${Erstellen.NAME_MAX}" placeholder="${esc(istCommunity ? T.communityName : T.unterthemaName)}"
                 aria-label="${esc(istCommunity ? T.communityName : T.unterthemaName)}" autocomplete="off">
          <span class="erstellseite__stern erstellseite__stern--ecke">✳</span>
        </label>
        ${istCommunity ? `
        <label class="erstellseite__bild" id="esBild" aria-label="${esc(T.bild)}">
          <input type="file" accept="image/*" id="esBildDatei" hidden>
          <span class="erstellseite__bildLeer" id="esBildLeer">${ICONS.image}<span>${esc(T.bild)}</span></span>
          <img id="esBildVorschau" alt="" hidden>
          <span class="erstellseite__bildMarke" id="esBildMarke" hidden>${esc(T.bildAendern)}</span>
          <span class="erstellseite__stern erstellseite__stern--ecke">✳</span>
        </label>` : ''}
        <textarea id="esBio" class="erstellseite__feld erstellseite__feld--abstand" rows="1" maxlength="${Erstellen.BIO_MAX}"
                  placeholder="${esc(T.bio)}" aria-label="${esc(T.bio)}"></textarea>
        <input id="esLink" class="erstellseite__feld" maxlength="${Erstellen.LINK_MAX}" inputmode="url" autocapitalize="off"
               placeholder="${esc(T.link)}" aria-label="${esc(T.link)}">
        ${istCommunity ? `
        <div class="erstellseite__strich"></div>
        <div id="esUnterthemen"></div>
        <button class="erstellseite__unterthemen" id="esUnterthemaNeu">
          <span class="erstellseite__plus">${ICONS.plus}</span>${esc(T.unterthemen)}
        </button>
        <div class="erstellseite__strich"></div>` : ''}
        <label class="erstellseite__schalter">
          <span>
            <span class="erstellseite__schalterTitel">${esc(istCommunity ? T.privatCommunity : T.privatUnterthema)}</span>
            <span class="erstellseite__schalterSub">${esc(istCommunity ? T.privatCommunitySub : T.privatUnterthemaSub)}</span>
          </span>
          <span class="schalter"><input type="checkbox" id="esPrivat"><span></span></span>
        </label>
        <button class="erstellseite__einladen" id="esEinladen">${esc(T.einladen)}</button>
        <p class="erstellseite__qrText">${esc(T.qr)}</p>
        <img class="erstellseite__qr" id="esQr" alt="QR-Code: ${esc(einladung)}" src="/api/einladung-qr.svg?code=${code}" width="200" height="200">
        <p class="erstellseite__qrHinweis">${esc(T.qrHinweis)}</p>
      </div>
      <div class="erstellseite__fuss">
        <p class="erstellseite__meldung" id="esMeldung" hidden></p>
        <button class="erstellseite__fertig" id="esFertig">${esc(T.fertig)}</button>
      </div>
    </div>`;

  // Fehler stehen auf der Seite, nicht in einem Toast hinter ihr.
  const meldung = (text) => {
    const el = $('#esMeldung');
    el.textContent = text || '';
    el.hidden = !text;
  };
  const schliessen = () => {
    overlay.hidden = true;
    overlay.innerHTML = '';
  };
  $('#esZu').addEventListener('click', schliessen);

  if (istCommunity) {
    $('#esBildDatei').addEventListener('change', async (e) => {
      const datei = e.target.files?.[0];
      e.target.value = '';
      if (!datei) return;
      let daten;
      try {
        daten = await bildVerkleinern(datei, 800);
      } catch {
        return meldung('Dieses Bild lässt sich nicht lesen');
      }
      meldung('Wird hochgeladen …');
      // Dieselbe Medienstelle wie das Profilbild (/api/hochladen, Ordner avatars).
      const hoch = await api('/api/hochladen', { ordner: 'avatars', aufnahme: daten });
      if (!hoch.ok) return meldung(hoch.error || 'Das Bild ließ sich nicht hochladen');
      stand.bild = hoch.url;
      const vorschau = $('#esBildVorschau');
      vorschau.src = hoch.anzeige || daten;
      vorschau.hidden = false;
      $('#esBildLeer').hidden = true;
      $('#esBildMarke').hidden = false;
      meldung('');
    });

    const zeichneUnterthemen = () => {
      $('#esUnterthemen').innerHTML = stand.unterthemen
        .map(
          (u, i) => `
        <div class="erstellseite__ut">
          <span class="erstellseite__raute">#</span>
          <input data-esut="${i}" value="${esc(u)}" maxlength="${Erstellen.NAME_MAX}"
                 placeholder="${esc(T.unterthemaPlatzhalter)}" aria-label="${esc(T.unterthemaPlatzhalter)} ${i + 1}">
          <button data-esutweg="${i}" aria-label="Unterthema ${i + 1} entfernen">${ICONS.close}</button>
        </div>`
        )
        .join('');
      $('#esUnterthemaNeu').hidden = stand.unterthemen.length >= Erstellen.UNTERTHEMEN_MAX;
      overlay.querySelectorAll('[data-esut]').forEach((el) =>
        el.addEventListener('input', () => (stand.unterthemen[Number(el.dataset.esut)] = el.value))
      );
      overlay.querySelectorAll('[data-esutweg]').forEach((b) =>
        b.addEventListener('click', () => {
          stand.unterthemen.splice(Number(b.dataset.esutweg), 1);
          zeichneUnterthemen();
        })
      );
    };
    $('#esUnterthemaNeu').addEventListener('click', () => {
      stand.unterthemen.push('');
      zeichneUnterthemen();
      overlay.querySelector(`[data-esut="${stand.unterthemen.length - 1}"]`)?.focus();
    });
  }

  $('#esEinladen').addEventListener('click', async () => {
    const name = $('#esName').value.trim() || (istCommunity ? 'meine Community' : 'mein Unterthema');
    const wie = istCommunity || !community ? name : `${name} (${community.name})`;
    const textTeilen = Erstellen.teilenText(art, wie, code, location.origin);
    try {
      if (navigator.share) return await navigator.share({ text: textTeilen });
    } catch (e) {
      if (e && e.name === 'AbortError') return;
    }
    try {
      await navigator.clipboard.writeText(einladung);
      meldung('');
      toast('Einladungslink kopiert');
    } catch {
      meldung(einladung);
    }
  });

  $('#esFertig').addEventListener('click', async () => {
    if (stand.laeuft) return;
    const eingabe = {
      name: $('#esName').value,
      bio: $('#esBio').value,
      link: $('#esLink').value,
      privat: $('#esPrivat').checked,
    };
    const geprueft = istCommunity
      ? Erstellen.pruefeCommunity({ ...eingabe, bild: !!stand.bild, unterthemen: stand.unterthemen })
      : Erstellen.pruefeUnterthema(eingabe);
    if (geprueft.fehler) return meldung(geprueft.fehler);
    const w = geprueft.werte;
    stand.laeuft = true;
    $('#esFertig').disabled = true;
    meldung('');
    const res = istCommunity
      ? await api('/api/communities', {
          name: w.name, bio: w.bio, link: w.link, bild: stand.bild, unterthemen: w.unterthemen,
          sichtbarkeit: w.privat ? 'private' : 'public', code,
        })
      : await api(`/api/communities/${community.id}/channels`, {
          name: w.name, bio: w.bio, link: w.link, privat: w.privat, code,
        });
    stand.laeuft = false;
    $('#esFertig').disabled = false;
    if (!res.ok) return meldung(res.error || 'Das hat nicht geklappt');

    schliessen();
    const fertigText = `„${w.name}“ erstellt`;
    toast(res.hinweis ? `${fertigText} · ${res.hinweis}` : fertigText);
    if (istCommunity) {
      state.area = 'communities';
      state.sub.communities = 'profile';
      await bootstrap();
    } else {
      renderCommunityChannels(community.id);
    }
  });

  $('#esName').focus();
}

/** Livestream: laufende Sendung mit Dauer, danach bleibt die Aufzeichnung. */
function openLivestream() {
  const begonnen = Date.now();
  overlay.hidden = false;
  overlay.innerHTML = `
    <div class="live">
      <div class="live__stage">
        ${ICONS.video}
        <div class="live__marke"><span class="live__punkt"></span>LIVE</div>
        <div class="live__zeit" id="liveZeit">00:00</div>
      </div>
      ${/*
          Die Live-Kommentarspalte aus dem Handbuch. Sie steht über der
          Leiste und nicht in einem Blatt: während einer Sendung ist sie das
          Gegenüber, und etwas, das man erst aufklappen muss, liest niemand.

          Damit Kommentare und Spenden irgendwo hingehören können, wird der
          Stream beim Start als Beitrag angelegt und nicht erst am Ende.
        */ ''}
      <div class="live__spalte" id="liveSpalte">
        <p class="live__leer">Kommentarspalte wird geöffnet …</p>
      </div>
      <div class="live__eingabe">
        <input id="liveText" placeholder="Etwas sagen …" disabled>
        <button id="liveSenden" disabled aria-label="Senden">${ICONS.send}</button>
      </div>
      <div class="live__leiste">
        <div class="live__zuschauer" id="liveZuschauer">0 Zuschauer</div>
        <div class="live__spenden" id="liveSpenden" hidden></div>
        ${/*
            Henrik am 28.09.2026: erst nach dem Ende entscheidet der Host,
            ob die Aufzeichnung als normales Querformat-Video erscheint -
            oder er stellt hier ein, dass das ohne Rueckfrage geschieht.
            Loeschen (Punkt 46) ist die andere Wahl nach dem Ende; das
            fruehere "Verwerfen" daneben waere dieselbe Wahl ein zweites Mal.
          */ ''}
        <label class="live__auto">
          <span>Aufzeichnung automatisch veröffentlichen</span>
          <span class="schalter">
            <input type="checkbox" id="liveAuto" ${schalterAn('liveAutoVeroeffentlichen') ? 'checked' : ''} />
            <span></span>
          </span>
        </label>
        <button class="prof__btn is-primary" id="liveStop">Livestream beenden</button>
        <div class="live__ende" id="liveEnde" hidden>
          <p class="live__endeText" id="liveEndeText"></p>
          <button class="prof__btn is-primary" id="liveVeroeffentlichen">Als Video veröffentlichen</button>
          <button class="prof__btn" id="liveLoeschen">Aufzeichnung löschen</button>
        </div>
      </div>
    </div>`;

  fetch('/api/eigene/livestream', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ aktion: 'start' }),
  });

  /*
   * Der Beitrag zum laufenden Stream. Erst mit ihm gibt es etwas, worauf
   * sich Kommentare und Spenden beziehen können; vorher gab es während der
   * Sendung nichts dergleichen, obwohl der Spendencode in den Einstellungen
   * genau dafür da ist.
   *
   * Scheitert das Anlegen, läuft der Stream trotzdem — nur ohne Spalte. Das
   * ist schlechter, aber kein Grund, gar nicht erst zu senden.
   */
  let streamId = null;
  let spaltenUhr = null;

  api('/api/stream/start', {})
    .then((antwort) => {
      if (!antwort?.ok || !antwort.id) {
        const leer = overlay.querySelector('.live__leer');
        if (leer) leer.textContent = 'Die Kommentarspalte konnte nicht geöffnet werden.';
        return;
      }
      streamId = antwort.id;

      const feld = overlay.querySelector('#liveText');
      const knopf = overlay.querySelector('#liveSenden');
      if (feld) feld.disabled = false;
      if (knopf) knopf.disabled = false;

      /*
       * Alle vier Sekunden nachladen. Ein Live-Abo wäre schöner, bräuchte
       * aber eine eigene Verbindung, die beim Verlassen sauber zugehen muss
       * — bei einer Kommentarspalte fällt der Unterschied nicht auf.
       */
      let fehlschlaege = 0;
      const holen = async () => {
        const spalte = overlay.querySelector('#liveSpalte');
        if (!spalte) return clearInterval(spaltenUhr);
        try {
          const res = await fetch(`/api/stream/${streamId}/kommentare`);
          if (!res.ok) return;
          fehlschlaege = 0;
          const daten = await res.json();
          const zeilen = daten.kommentare || [];
          spalte.innerHTML = zeilen.length
            ? zeilen
                .slice(-30)
                .map(
                  (k) => `<p class="live__kommentar"><b>${esc(k.name)}</b> ${esc(k.text)}</p>`
                )
                .join('')
            : '<p class="live__leer">Noch keine Kommentare.</p>';
          spalte.scrollTop = spalte.scrollHeight;
        } catch (fehler) {
          /* Ein Aussetzer im Vier-Sekunden-Takt holt die naechste Runde nach;
             erst drei hintereinander sind eine Stoerung. Gleiche Regel in der
             App (LivestreamScreen, ClipPlayerScreen). */
          fehlschlaege += 1;
          if (fehlschlaege === 3) console.warn('Streamkommentare laden fehlgeschlagen:', fehler);
        }
      };

      holen();
      spaltenUhr = setInterval(holen, 4000);

      const senden = async () => {
        const text = feld.value.trim();
        if (!text) return;
        feld.value = '';
        const antwortK = await api(`/api/stream/${streamId}/kommentare`, { text });
        if (!antwortK?.ok) return toast(antwortK?.error || 'Der Kommentar ging nicht durch');
        holen();
      };

      knopf?.addEventListener('click', senden);
      feld?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') senden();
      });
    });

  // Die Zuschauerzahl waechst langsam - sonst sieht der Bildschirm tot aus.
  let zuschauer = 0;
  const uhr = setInterval(() => {
    const s = Math.round((Date.now() - begonnen) / 1000);
    const zeit = overlay.querySelector('#liveZeit');
    if (!zeit) return clearInterval(uhr);
    zeit.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    if (s % 3 === 0) {
      zuschauer += 1;
      overlay.querySelector('#liveZuschauer').textContent = `${zuschauer} ${zuschauer === 1 ? 'Zuschauer' : 'Zuschauer'}`;
    }
  }, 1000);

  overlay.querySelector('#liveAuto').addEventListener('change', (e) =>
    einstellungSetzen({ wahlKey: 'liveAutoVeroeffentlichen' }, e.target.checked ? 'an' : 'aus')
  );

  let endeSekunden = 0;

  const abschliessen = async (veroeffentlichen) => {
    if (spaltenUhr) clearInterval(spaltenUhr);
    if (streamId) {
      const daten = await api(`/api/stream/${streamId}/ende`, {
        veroeffentlichen,
        sekunden: endeSekunden,
        zuschauer,
      });
      if (!daten?.ok) {
        toast(daten?.error || 'Das ging nicht durch');
        return;
      }
    } else {
      // Ohne Beitrag gibt es nichts zu entscheiden, nur das Profil zu leeren.
      await api('/api/eigene/livestream', { aktion: 'stop' });
    }
    overlay.hidden = true;
    overlay.innerHTML = '';
    state.area = 'videos';
    state.sub.videos = 'landscape';
    await bootstrap();
    toast(
      veroeffentlichen && streamId
        ? 'Livestream beendet, die Aufzeichnung steht im Querformat'
        : 'Livestream beendet, die Aufzeichnung ist gelöscht'
    );
  };

  overlay.querySelector('#liveStop').addEventListener('click', () => {
    clearInterval(uhr);
    endeSekunden = Math.max(1, Math.round((Date.now() - begonnen) / 1000));
    if (overlay.querySelector('#liveAuto').checked) return abschliessen(true);

    // Die Sendung steht, jetzt die Wahl - an derselben Stelle wie der Knopf.
    overlay.querySelector('#liveStop').hidden = true;
    overlay.querySelector('.live__auto').hidden = true;
    overlay.querySelector('.live__eingabe').hidden = true;
    overlay.querySelector('#liveEndeText').textContent = `Livestream beendet · ${
      overlay.querySelector('#liveZeit').textContent
    } · ${zuschauer} Zuschauer`;
    overlay.querySelector('#liveEnde').hidden = false;
  });
  overlay.querySelector('#liveVeroeffentlichen').addEventListener('click', () => abschliessen(true));
  overlay.querySelector('#liveLoeschen').addEventListener('click', () => abschliessen(false));
}

/* ------------------------------------------------------- Videos: Profil */
/*
 * Prototyp-Frame "Videos - Profil": Leiste "Profil wechseln", darunter
 * @Nutzername mit Glocke/Plus/Menue, Bild links neben den Zahlen, dann Name,
 * Biografie und Link linksbuendig, Playlists und Highlights, Tab-Leiste und
 * das Beitragsraster.
 */
function ownProfileTop(handle, bereich) {
  const ungelesen = state.ungelesen?.[bereich] || 0;
  return `
    <div class="oprof__bar">
      <span class="oprof__handle">${esc(handle)}</span>
      <span class="oprof__acts">
        <button data-oact="bell" aria-label="Mitteilungen${ungelesen ? `, ${ungelesen} ungelesen` : ''}">${ICONS.bell}${
          ungelesen ? '<i class="oprof__dot"></i>' : ''
        }</button>
        <button data-oact="create" aria-label="Erstellen">${ICONS.plus}</button>
        <button data-oact="menu" aria-label="Menü">${ICONS.menu}</button>
      </span>
    </div>`;
}

/*
 * Die Reihe aus Playlists und Highlights unter einem Profil.
 *
 * Als eigene Funktion, weil Henrik am 26.08.2026 zwei Dinge dazu gemeldet
 * hat, die beide daher kamen, dass es die Reihe zweimal gab:
 *
 *   Punkt 39  Playlist und Highlight waren nicht zu unterscheiden.
 *   Punkt 48  Auf fremden Profilen waren sie ueberhaupt nicht klickbar - dort
 *             standen sie als <div> in der Story-Leiste, im eigenen Profil
 *             als <button> in einer anderen Leiste.
 *
 * Jetzt bauen beide Profile dieselbe Reihe. Das Aussehen (Kreis gegen weiches
 * Quadrat, zwei Verlaeufe, Kennzeichen) steckt im CSS unter `.highlight`.
 *
 * `userId` wandert mit ins Attribut, damit die Seite dahinter weiss, wessen
 * Sammlung sie zeigt.
 */
/*
 * Was an Sammlungen schon geladen ist, nach Profil abgelegt.
 *
 * Die Reihe wird mitten im Zusammenbauen einer Seite als Zeichenkette
 * erzeugt und kann nicht warten. Sie zeichnet deshalb erst aus dem, was da
 * ist, und `ladeSammlungen` ersetzt sie, sobald die Antwort eintrifft.
 */
const SAMMLUNGEN = new Map();

/*
 * Zaehler gegen verspaetete Antworten.
 *
 * `ladeSammlungen` schickt seine Abfrage los und traegt das Ergebnis ein,
 * wenn es eintrifft. Wird in der Zwischenzeit eine Sammlung geloescht, kaeme
 * die ALTE Liste danach an, legte sich in den Zwischenspeicher und malte den
 * geloeschten Kreis zurueck — Datenbank sauber, Bildschirm falsch, und zwar
 * bleibend, bis jemand die Seite neu laedt.
 *
 * Vorsorge, kein beobachteter Fehler: der Lauf vom 20.09.2026 hat dieses
 * Rennen nie gewonnen. Es ist nur nicht ausgeschlossen, und der Preis dafuer
 * sind drei Zeilen. Wer etwas an den Sammlungen aendert, zaehlt hoch; eine
 * Antwort von vorher wird dann weggeworfen.
 */
let sammlungenLauf = 0;

/*
 * Ringfarbe und -staerke je Gattung aus gemeinsam/sammlungen.js (Kasten 12.9)
 * — dieselbe Quelle wie VideoProfileScreen und UserProfileScreen in der App.
 * Der Kreis ist 64 px gross; die Staerke rechnet der Baustein.
 */
